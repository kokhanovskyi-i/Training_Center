<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_training_center" model="ir.module.category">
        <field name="name">Training Center</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_training_center_roles" model="res.groups.privilege">
        <field name="name">Training Center</field>
        <field name="category_id" ref="training_center.module_category_training_center"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_training_center_student" model="res.groups">
        <field name="name">Student</field>
        <field name="privilege_id" ref="training_center.privilege_training_center_roles"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_center_assistant" model="res.groups">
        <field name="name">Assistant</field>
        <field name="privilege_id" ref="training_center.privilege_training_center_roles"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('training_center.group_training_center_student'))]"/>
    </record>

    <record id="group_training_center_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="privilege_id" ref="training_center.privilege_training_center_roles"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('training_center.group_training_center_assistant'))]"/>
    </record>

    <record id="group_training_center_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="training_center.privilege_training_center_roles"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('training_center.group_training_center_teacher'))]"/>
    </record>

    <record id="group_training_center_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="training_center.privilege_training_center_roles"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('training_center.group_training_center_manager'))]"/>
    </record>
</odoo>