<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_training_center_user_own_lessons" model="ir.rule">
        <field name="name">Training Center User: own lessons</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">
            ['|', ('teacher_id.user_id', '=', user.id), ('student_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_training_center_admin_all_lessons" model="ir.rule">
        <field name="name">Training Center Admin: all lessons</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>