<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_training_center_lesson_student_own" model="ir.rule">
        <field name="name">Student: own lessons only</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_training_center_lesson_assistant_own" model="ir.rule">
        <field name="name">Assistant: own lessons</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_assistant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_training_center_lesson_teacher_own_and_assistants" model="ir.rule">
        <field name="name">Teacher: own and assistants lessons</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">['|', ('teacher_id.user_id', '=', user.id), ('teacher_id.mentor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_teacher'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_training_center_lesson_manager_all" model="ir.rule">
        <field name="name">Manager: all lessons read only</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_training_center_lesson_admin_all" model="ir.rule">
        <field name="name">Administrator: all lessons full access</field>
        <field name="model_id" ref="model_training_center_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('training_center.group_training_center_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>