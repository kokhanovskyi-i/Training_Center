<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_hr_hospital_appointment_patient_own" model="ir.rule">
        <field name="name">Patient: own visits only</field>
        <field name="model_id" ref="model_hr_hospital_appointment"/>
        <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_hospital_appointment_intern_own" model="ir.rule">
        <field name="name">Intern: own visits</field>
        <field name="model_id" ref="model_hr_hospital_appointment"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_intern'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_hospital_appointment_doctor_own_and_interns" model="ir.rule">
        <field name="name">Doctor: own and interns visits</field>
        <field name="model_id" ref="model_hr_hospital_appointment"/>
        <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_hospital_appointment_manager_all" model="ir.rule">
        <field name="name">Manager: all visits read only</field>
        <field name="model_id" ref="model_hr_hospital_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_hospital_appointment_admin_all" model="ir.rule">
        <field name="name">Administrator: all visits full access</field>
        <field name="model_id" ref="model_hr_hospital_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_hospital.group_hr_hospital_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>