<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_training_center_teacher_report_a4" model="report.paperformat">
        <field name="name">Training Center Teacher Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_training_center_teacher" model="ir.actions.report">
        <field name="name">Teacher Report</field>
        <field name="model">training.center.teacher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">training_center.report_teacher_document</field>
        <field name="report_file">training_center.report_teacher_document</field>
        <field name="binding_model_id" ref="model_training_center_teacher"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="training_center.paperformat_training_center_teacher_report_a4"/>
        <field name="print_report_name">'Teacher Report - %s' % object.name</field>
    </record>
</odoo>