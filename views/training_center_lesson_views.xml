<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_training_center_lesson_list" model="ir.ui.view">
        <field name="name">training.center.lesson.list</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <list>
                <field name="planned_datetime"/>
                <field name="lesson_datetime"/>
                <field name="status"/>
                <field name="student_id"/>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_training_center_lesson_form" model="ir.ui.view">
        <field name="name">training.center.lesson.form</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_done"
                            type="object"
                            string="Mark as Done"
                            class="btn-primary"
                            invisible="status != 'planned'"/>

                    <button name="action_set_cancelled"
                            type="object"
                            string="Cancel"
                            invisible="status == 'cancelled'"/>

                    <button name="action_set_planned"
                            type="object"
                            string="Reset to Planned"
                            invisible="status == 'planned'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="planned,done,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_same_subject_lessons"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not subject_id">
                            <field name="same_subject_lesson_count"
                                   widget="statinfo"
                                   string="Same Subject Lessons"/>
                        </button>
                    </div>

                    <group>
                        <group string="Lesson Information">
                            <field name="planned_datetime"/>
                            <field name="lesson_datetime"/>
                            <field name="active"/>
                        </group>

                        <group string="Student and Teacher">
                            <field name="student_id"/>
                            <field name="teacher_id"/>
                            <field name="subject_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Summary">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_center_lesson_calendar" model="ir.ui.view">
        <field name="name">training.center.lesson.calendar</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <calendar string="Lessons"
                      date_start="planned_datetime"
                      date_stop="lesson_datetime"
                      color="teacher_id">
                <field name="student_id"/>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_training_center_lesson_search" model="ir.ui.view">
        <field name="name">training.center.lesson.search</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="status"/>

                <filter name="planned"
                        string="Planned"
                        domain="[('status', '=', 'planned')]"/>

                <filter name="done"
                        string="Completed"
                        domain="[('status', '=', 'done')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('status', '=', 'cancelled')]"/>

                <filter name="current_year"
                        string="Current Year"
                        domain="[('planned_datetime', '&gt;=', context_today().strftime('%Y-01-01 00:00:00')), ('planned_datetime', '&lt;=', context_today().strftime('%Y-12-31 23:59:59'))]"/>

                <separator/>

                <filter name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}"/>

                <filter name="group_by_teacher"
                        string="Teacher"
                        context="{'group_by': 'teacher_id'}"/>

                <filter name="group_by_month"
                        string="Month"
                        context="{'group_by': 'planned_datetime:month'}"/>

                <searchpanel>
                    <field name="teacher_id"
                           string="Teacher"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_training_center_lesson_pivot" model="ir.ui.view">
        <field name="name">training.center.lesson.pivot</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <pivot string="Lessons Analysis">
                <field name="teacher_id" type="row"/>
                <field name="planned_datetime" type="row" interval="month"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_training_center_lesson_graph" model="ir.ui.view">
        <field name="name">training.center.lesson.graph</field>
        <field name="model">training.center.lesson</field>
        <field name="arch" type="xml">
            <graph string="Lessons by Month and Subject"
                   type="bar"
                   stacked="1">
                <field name="planned_datetime" interval="month"/>
                <field name="subject_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_training_center_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">training.center.lesson</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_training_center_lesson_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>
</odoo>