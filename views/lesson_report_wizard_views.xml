<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_lesson_report_wizard_form" model="ir.ui.view">
        <field name="name">training.center.lesson.report.wizard.form</field>
        <field name="model">training.center.lesson.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="teacher_ids" widget="many2many_tags"/>
                        <field name="student_ids" widget="many2many_tags"/>
                        <field name="subject_id"/>
                    </group>

                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_done"/>
                    </group>
                </group>

                <footer>
                    <button name="action_show_lessons"
                            string="Show Lessons"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lesson_report_wizard_from_student" model="ir.actions.act_window">
        <field name="name">Lesson Report</field>
        <field name="res_model">training.center.lesson.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lesson_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_training_center_student"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_lesson_report_wizard_from_teacher" model="ir.actions.act_window">
        <field name="name">Lesson Report</field>
        <field name="res_model">training.center.lesson.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lesson_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_training_center_teacher"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>