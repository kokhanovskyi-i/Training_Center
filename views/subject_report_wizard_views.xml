<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_subject_report_wizard_form" model="ir.ui.view">
        <field name="name">training.center.subject.report.wizard.form</field>
        <field name="model">training.center.subject.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Subject Report">
                <group>
                    <field name="teacher_ids"
                           widget="many2many_tags"
                           placeholder="Leave empty to include all teachers"/>

                    <field name="subject_ids"
                           widget="many2many_tags"
                           placeholder="Leave empty to include all subjects"/>

                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button name="action_show_report"
                            string="Show Report"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subject_report_wizard" model="ir.actions.act_window">
        <field name="name">Subject Report</field>
        <field name="res_model">training.center.subject.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_subject_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_training_center_teacher"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>