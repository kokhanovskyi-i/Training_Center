<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_training_center_subject_list" model="ir.ui.view">
        <field name="name">training.center.subject.list</field>
        <field name="model">training.center.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_training_center_subject_form" model="ir.ui.view">
        <field name="name">training.center.subject.form</field>
        <field name="model">training.center.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Subject Information">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Child Subjects">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_center_subject_search" model="ir.ui.view">
        <field name="name">training.center.subject.search</field>
        <field name="model">training.center.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       string="Subject"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>

                <field name="parent_id"/>

                <separator/>

                <filter name="root_subjects"
                        string="Root Subjects"
                        domain="[('parent_id', '=', False)]"/>

                <filter name="child_subjects"
                        string="Child Subjects"
                        domain="[('parent_id', '!=', False)]"/>

                <separator/>

                <filter name="group_by_parent"
                        string="Parent Subject"
                        context="{'group_by': 'parent_id'}"/>

                <searchpanel>
                    <field name="parent_id"
                           string="Subject Hierarchy"
                           select="one"
                           hierarchize="1"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_training_center_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">training.center.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_center_subject_search"/>
    </record>
</odoo>